{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SS14 Studio 2.0 Preview",
  "version": "0.2.0-alpha.1",
  "identifier": "com.darvin7531.ss14studio.v2",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SS14 Studio 2.0 — Preview",
        "width": 1050,
        "height": 710,
        "minWidth": 740,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
